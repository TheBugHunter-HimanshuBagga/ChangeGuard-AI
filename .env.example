# ============================================================================
# ChangeGuard AI — environment template
# Copy to .env and fill real values. NEVER commit .env or real secrets.
# Document every new variable here when introduced.
# ============================================================================

# --- General ---
APP_ENV=local
LOG_LEVEL=INFO
CORRELATION_HEADER=X-Correlation-ID

# --- Control Plane (backend/springboot-app) ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# PostgreSQL (Flyway owns schema migrations)
DB_URL=jdbc:postgresql://localhost:5432/changeguard
DB_USER=changeguard
DB_PASSWORD=change_me_local_only

# Redis (cache / idempotency / progress — not source of truth)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=replace_with_long_random_secret_local_only
JWT_TTL_MINUTES=60

# --- GitHub App (Control Plane) ---
GITHUB_APP_ID=
# Private key: provide ONE of the following (never commit the key itself)
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=replace_me_webhook_secret
# Optional API base override for testing
GITHUB_API_BASE_URL=https://api.github.com

# --- Intelligence Plane (ml-engine) ---
ML_ENGINE_BASE_URL=http://localhost:8000
ML_ENGINE_SERVICE_TOKEN=replace_me_s2s_token_ml
ML_ENGINE_HOST=0.0.0.0
ML_ENGINE_PORT=8000
# Model registry location (versioned artifacts; exact backend TBD in ML phase)
MODEL_REGISTRY_PATH=./models
DEFAULT_MODEL_VERSION=

# --- Execution Plane (execution-engine) ---
EXECUTION_ENGINE_BASE_URL=http://localhost:8010
EXECUTION_ENGINE_SERVICE_TOKEN=replace_me_s2s_token_exec
EXECUTION_ENGINE_PORT=8010
# Isolation limits (defaults applied per job if omitted)
EXECUTION_DEFAULT_CPU=2
EXECUTION_DEFAULT_MEMORY_MB=4096
EXECUTION_DEFAULT_WALL_CLOCK_SECONDS=2400
# Artifact storage root for execution evidence
ARTIFACT_STORAGE_URI=file:///var/lib/changeguard/artifacts

# --- Frontend (frontend) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- Docker / local stack (infrastructure) ---
POSTGRES_DB=changeguard
POSTGRES_USER=changeguard
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
