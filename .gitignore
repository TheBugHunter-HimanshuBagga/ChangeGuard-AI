backend/springboot-app/target/
*.class
*.jar
*.war
!gradle/wrapper/gradle-wrapper.jar
.mvn/wrapper/maven-wrapper.jar

# --- Python (ml-engine / tooling) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
