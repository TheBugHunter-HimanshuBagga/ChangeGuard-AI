# ChangeGuard AI — Intelligence Plane (ml-engine) environment
# Copy to .env and adjust. NEVER commit real secrets.

# Bind address and port for the FastAPI service
ML_ENGINE_HOST=0.0.0.0
ML_ENGINE_PORT=8000

# Logging: DEBUG | INFO | WARNING | ERROR
ML_ENGINE_LOG_LEVEL=INFO

# Reported by /api/v1/health
ML_ENGINE_SERVICE_VERSION=0.1.0
